# Copy to .env and fill in. All optional: without these the engine runs and simply sends no alerts.
# In GitHub Actions the same names are repo secrets (same ones as the tripwires repo).

# Where the page is hosted (added to alerts)
SITE_URL=

# Email alerts (Gmail app password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=

# Phone push (optional): https://pushover.net
PUSHOVER_USER=
PUSHOVER_TOKEN=
